{
  "name": "mochy-web",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/start.js",
    "test": "node --test tests/*.test.js",
    "desktop": "npm run build && electron electron/main.cjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "music-metadata": "^12.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "id.mochy.web",
    "productName": "Mochy",
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "main": "electron/main.cjs",
  "description": "An independent responsive web and desktop adaptation of Mochy Music",
  "author": "Mochy Web contributors",
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
